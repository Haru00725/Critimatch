# Supabase: Project Settings > Database > Connection string
# Pooled (port 6543) for the app, direct (port 5432) for migrations.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Random long strings (e.g. `openssl rand -hex 32`)
AUTH_SECRET="change-me"
CRON_SECRET="change-me-too"

# LLM (any OpenAI-compatible endpoint). Leave LLM_API_KEY empty to use the built-in fallback extractor.
LLM_API_KEY=""
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="llama-3.3-70b-versatile"
